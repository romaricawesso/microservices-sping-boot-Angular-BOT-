spring.application.name=ebank-service
server.port=8087

# Pas de serveur de config pour l'instant
# Enregistrement aupres d'Eureka (discovery-service)
spring.cloud.config.enabled=false
eureka.client.service-url.defaultZone=http://localhost:8761/eureka
eureka.instance.prefer-ip-address=true

# Base H2 en memoire
spring.datasource.url=jdbc:h2:mem:accounts-db
spring.h2.console.enabled=true

# Resilience4j : circuit breaker sur les appels Feign vers customer-service
spring.cloud.openfeign.circuitbreaker.enabled=true
# le circuit s'ouvre si 50% des 10 derniers appels echouent, et reste ouvert 10s
resilience4j.circuitbreaker.configs.default.sliding-window-size=10
resilience4j.circuitbreaker.configs.default.minimum-number-of-calls=5
resilience4j.circuitbreaker.configs.default.failure-rate-threshold=50
resilience4j.circuitbreaker.configs.default.wait-duration-in-open-state=10s
resilience4j.circuitbreaker.configs.default.permitted-number-of-calls-in-half-open-state=3
# un client introuvable (404) n'est pas une panne : il n'ouvre pas le circuit
resilience4j.circuitbreaker.configs.default.ignore-exceptions=feign.FeignException$NotFound
# temps max d'un appel avant de passer au fallback (1s par defaut)
resilience4j.timelimiter.configs.default.timeout-duration=3s

# Serveur MCP (Streamable HTTP) : outils disponibles sur http://localhost:8087/mcp
spring.ai.mcp.server.name=ebank-mcp-server
spring.ai.mcp.server.version=1.0.0
spring.ai.mcp.server.protocol=STREAMABLE
spring.ai.mcp.server.type=SYNC
