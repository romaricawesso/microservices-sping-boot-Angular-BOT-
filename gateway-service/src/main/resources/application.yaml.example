server:
  port: 8080

spring:
  cloud:
    gateway:
      server:
        webflux:
          # Routage automatique par Eureka : /NOM-DU-SERVICE/** (ex. /EBANK-SERVICE/accounts)
          discovery:
            locator:
              enabled: true
          routes:
            - id: customer-service
              uri: lb://customer-service
              predicates:
                - Path=/customers/**
            - id: ebank-service
              uri: lb://ebank-service
              predicates:
                - Path=/accounts/**
          # CORS : autorise toutes les origines (pratique en developpement, a restreindre en production)
          globalcors:
            cors-configurations:
              '[/**]':
                allowed-origins:
                  - "*"
                allowed-methods:
                  - "*"
                allowed-headers:
                  - "*"
                max-age: 3600

# Enregistrement aupres d'Eureka (discovery-service)
eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka
  instance:
    prefer-ip-address: true
