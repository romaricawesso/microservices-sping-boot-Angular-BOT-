spring.application.name=ebank-bot
server.port=8088

# Pas de serveur de config pour l'instant
spring.cloud.config.enabled=false

# Enregistrement aupres d'Eureka (discovery-service)
eureka.client.service-url.defaultZone=http://localhost:8761/eureka
eureka.instance.prefer-ip-address=true
spring.cloud.discovery.enabled=true

# Modele local Ollama (installer avec : ollama pull qwen2.5:7b)
# qwen2.5 gere bien l appel d outils MCP ; modele cloud possible : gpt-oss:120b-cloud (apres "ollama signin")
spring.ai.ollama.base-url=http://localhost:11434
spring.ai.ollama.chat.model=qwen2.5:7b
spring.ai.ollama.chat.temperature=0.3

# Client MCP : serveurs MCP de customer-service et ebank-service (endpoint /mcp)
# Connexions gerees par McpServerConnections (a la demande) : le bot demarre meme si un service
# est arrete, ignore les outils d'un service indisponible et se reconnecte quand il revient.
# L'auto-configuration Spring AI est desactivee car elle exige tous les serveurs au demarrage.
spring.ai.mcp.client.enabled=false
ebank.mcp.request-timeout=30s
ebank.mcp.servers.customer-service=http://localhost:8086
ebank.mcp.servers.ebank-service=http://localhost:8087

# Bot Discord (optionnel) : token du Discord Developer Portal (Bot > Reset Token).
# Activer aussi "Message Content Intent" (Bot > Privileged Gateway Intents).
# Laisser cette ligne commentee pour demarrer sans bot Discord. Ne jamais commiter le vrai token.
#discord.bot.token=VOTRE_TOKEN_DISCORD

# Bot Telegram (optionnel) : token donne par @BotFather (commande /newbot).
# Laisser cette ligne commentee pour demarrer sans bot Telegram. Ne jamais commiter le vrai token.
#telegram.bot.token=VOTRE_TOKEN_TELEGRAM

# Memoire du bot : nombre de messages gardes par conversation (questions + reponses)
ebank.chat.memory.max-messages=10

# /chatStream : duree max d'une reponse en streaming (Tomcat coupe a 30 s par defaut)
spring.mvc.async.request-timeout=5m
